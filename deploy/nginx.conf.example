# Nginx reverse proxy for PayTrack — Next.js on 127.0.0.1:3000.
# Put in /etc/nginx/sites-available/paytrack, symlink to sites-enabled, then
# run certbot to add the SSL (443) block automatically:
#   sudo certbot --nginx -d your-domain.com

server {
    listen 80;
    server_name your-domain.com;

    # Allow proof/instruction uploads up to 10 MB (matches MAX_UPLOAD_MB).
    client_max_body_size 12m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
