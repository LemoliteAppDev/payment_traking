# ─── Database (MySQL) ───────────────────────────────────────────────
# Local dev (Homebrew MySQL, root, no password):
DATABASE_URL="mysql://root@localhost:3306/paytrack"

# ─── File uploads ───────────────────────────────────────────────────
# Absolute or project-relative dir OUTSIDE the web root. Never /public.
UPLOAD_DIR="./var/uploads"
MAX_UPLOAD_MB="10"

# ─── Auth (login ID + password) ─────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me"
# The 4 whitelisted login IDs. Only these may sign in (must match seeded users).
AUTH_WHITELIST="mahesh@payment.com,jignesh@payment.com,jagat@payment.com,bhadresh@payment.com"
# Temp password applied to newly-seeded users (change via `npm run set-password`).
SEED_PASSWORD="paytrack123"

# ─── Telegram — outbound notifications. Leave blank in dev to log sends to console.
TELEGRAM_BOT_TOKEN=""

# ─── Web Push (browser notifications) ───────────────────────────────
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@your-domain.com"

# ─── Reminders / cron ───────────────────────────────────────────────
# Cron endpoint is rejected without this header value (x-cron-secret).
CRON_SECRET="dev-cron-secret-change-me"
# Working hours in IST (24h). No reminders fire outside this window.
WORK_HOURS_START="9"
WORK_HOURS_END="21"
# Timezone used for the working-hours gate and overdue derivation.
APP_TZ="Asia/Kolkata"
