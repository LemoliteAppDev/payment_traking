// PayTrack schema — MySQL. Money is integer paise (BigInt).
// See paytrack-handoff-spec.md §3 for the field-level rationale.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Status {
  AWAITING_APPROVAL
  RETURNED
  REQUESTED
  SCHEDULED
  PAID
  CONFIRMED
  HOLD
  CANCELLED
}

enum AttachmentKind {
  INSTRUCTION
  PROOF
}

enum PaymentSourceType {
  ACCOUNT
  INDIVIDUAL
}

enum ReminderStatus {
  PENDING
  PAID
}

enum EventType {
  REQUEST
  APPROVE
  RETURN
  RESUBMIT
  EDIT
  SCHEDULE
  PAY
  CONFIRM
  HOLD
  CANCEL
  NUDGE
  REMINDER
  NOTE
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  role                Role
  isPayer             Boolean   @default(false)
  isApprover          Boolean   @default(false)
  isManager           Boolean   @default(false)
  active              Boolean   @default(true)
  telegramChatId      String?
  passwordHash        String?
  emailVerified       DateTime?
  notificationsReadAt DateTime?
  createdAt           DateTime  @default(now())

  requested   Payment[]      @relation("requestedBy")
  paid        Payment[]      @relation("paidBy")
  confirmed   Payment[]      @relation("confirmedBy")
  approved    Payment[]      @relation("approvedBy")
  events      PaymentEvent[]
  attachments Attachment[]

  remindersAdded        Reminder[]             @relation("reminderCreatedBy")
  remindersPaid         Reminder[]             @relation("reminderPaidBy")
  reminderPreference    ReminderPreference?
  reminderNotifications ReminderNotification[]

  accounts          Account[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]
  otpMessages       OtpMessage[]

  chatDevices  ChatDevice[]
  chatSent     ChatMessage[] @relation("chatSender")
  chatThreadsA ChatThread[]  @relation("chatThreadA")
  chatThreadsB ChatThread[]  @relation("chatThreadB")
  chatReads    ChatRead[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.VarChar(512)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  // Delivery health, so "did everyone get it?" is answerable per device.
  // A device that keeps failing is a silent subscription, not a happy one.
  device        String?   @db.VarChar(120) // friendly label, e.g. "Android · Chrome"
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastError     String?   @db.VarChar(180)
  failureCount  Int       @default(0)

  @@index([userId])
}

// ── Auth.js (NextAuth) adapter models ────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Payment {
  id             String            @id @default(cuid())
  amount         BigInt // integer paise
  payee          String
  payFrom        String // name of a PayAccount (the source to pay from)
  payFromType    PaymentSourceType @default(ACCOUNT)
  isPrivate      Boolean           @default(false) // private approver<->payer payment
  purpose        String            @db.Text
  upi            String?
  status         Status            @default(REQUESTED)
  dueDate        DateTime
  scheduledFor   DateTime?
  editedAt       DateTime?
  approvedAt     DateTime?
  paidAt         DateTime?
  confirmedAt    DateTime?
  lastRemindedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  requestedById String
  requestedBy   User    @relation("requestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("approvedBy", fields: [approvedById], references: [id])
  paidById      String?
  paidBy        User?   @relation("paidBy", fields: [paidById], references: [id])
  confirmedById String?
  confirmedBy   User?   @relation("confirmedBy", fields: [confirmedById], references: [id])

  attachments Attachment[]
  events      PaymentEvent[]
  otpMessages OtpMessage[]

  @@index([status])
  @@index([requestedById])
  @@index([dueDate])
}

model Attachment {
  id           String         @id @default(cuid())
  paymentId    String
  payment      Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  originalName String
  storedName   String         @unique
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  events PaymentEvent[]

  @@index([paymentId])
}

model PaymentEvent {
  id           String      @id @default(cuid())
  paymentId    String
  payment      Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?       @relation(fields: [actorId], references: [id])
  type         EventType
  message      String      @db.Text
  attachmentId String?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])
  meta         Json?
  createdAt    DateTime    @default(now())

  @@index([paymentId, createdAt])
}

// Sources money is paid from (the "Pay from" list). Managed by admins.
model PayAccount {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0) // display priority (lower = higher up)
  createdAt DateTime @default(now())
}

// Private individual names Jagat can route payments from, shared only with
// approver/payer workflows. Payments store the display name on payFrom.
model PrivateMember {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Secure OTP thread between the approver and payer for a payment.
// Body is encrypted at rest; rows auto-expire and are purged on read.
model OtpMessage {
  id        String   @id @default(cuid())
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  body      String   @db.Text // AES-256-GCM ciphertext (iv:tag:data, base64)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([paymentId])
}

// EMI / recurring-due reminders. Standalone from Payment: no approval, no
// proof, no payer flow. Only the manager (Jignesh) adds/edits; the manager,
// approver and payer all get the reminders and any of them can mark it paid.
// Reminders fire on D-3, D-2, D-1, D and keep going daily past the due date
// until somebody marks it paid. See lib/emi-reminders.ts.
model Reminder {
  id          String         @id @default(cuid())
  description String         @db.Text // EMI description, e.g. "Car loan EMI — HDFC"
  amount      BigInt // integer paise
  dueDate     DateTime // date-granularity (UTC midnight of the due day)
  status      ReminderStatus @default(PENDING)

  paidOn   DateTime? // the day it was actually paid (marker picks it)
  paidAt   DateTime? // when the mark was made
  paidById String?
  paidBy   User?     @relation("reminderPaidBy", fields: [paidById], references: [id])
  paidNote String?   @db.Text

  createdById String
  createdBy   User   @relation("reminderCreatedBy", fields: [createdById], references: [id])

  // Rows generated from one "repeats monthly" entry share a seriesId, so the
  // whole run can be cancelled without deleting 36 rows by hand.
  seriesId String?

  // Per-EMI timing. Null on either means "use the house default"
  // (ReminderSetting), so changing the default moves every inheriting row.
  sendHours String? // comma-separated hours in APP_TZ, e.g. "11,21"
  leadDays  Int? // how many days before the due date reminders start

  // Kept for display ("last reminded"). De-duplication is per person, in
  // ReminderNotification — a shared stamp would let the first recipient's send
  // suppress everyone else's when their schedules differ.
  lastRemindedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  notifications ReminderNotification[]

  @@index([status, dueDate])
  @@index([dueDate])
  @@index([seriesId])
}

// House defaults for EMI reminders, editable in-app by the manager. A single
// row, id "default". Reminders with their own sendHours/leadDays ignore it.
// Falls back to EMI_REMINDER_HOURS / 3 when the row is missing.
model ReminderSetting {
  id          String   @id @default("default")
  sendHours   String   @default("11,21")
  leadDays    Int      @default(3)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// One person's own reminder timing. Null on a field means "follow the group"
// (ReminderSetting). Each of the three sets their own.
model ReminderPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sendHours String?
  leadDays  Int?
  updatedAt DateTime @updatedAt
}

// When each person was last told about each reminder. Per-person because the
// three can be on different schedules for the same EMI.
model ReminderNotification {
  id         String   @id @default(cuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sentAt     DateTime

  @@unique([reminderId, userId])
  @@index([userId])
}

model IdempotencyKey {
  key       String   @id
  scope     String
  createdAt DateTime @default(now())
}

// ── End-to-end encrypted chat ────────────────────────────────────────
// Person-to-person messages. The server stores ciphertext only: it has no
// key material and cannot read a message, a file name or a voice note.
//
// How it works (see lib/e2ee.ts for the browser half):
//   1. Every browser registers a ChatDevice — an ECDH P-256 public key. The
//      private half is a non-extractable CryptoKey in IndexedDB and never
//      leaves the device, so it never reaches this database.
//   2. A message gets a fresh AES-256-GCM content key. Body, file bytes and
//      file name are encrypted with it.
//   3. The content key is wrapped once per recipient device (ChatEnvelope),
//      using ephemeral-static ECDH + HKDF. Only that device can unwrap it.
// What the server therefore still knows: who talks to whom, when, and the
// coarse kind (text / image / file / audio). That metadata is what makes the
// list view and push pings possible; content is out of reach.

enum ChatKind {
  TEXT
  IMAGE
  FILE
  AUDIO
}

model ChatDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?  @db.VarChar(120) // "Android · Chrome", for the device list
  publicKey  String   @db.Text // ECDH P-256 public key, JWK
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  sent      ChatMessage[]  @relation("chatSenderDevice")
  envelopes ChatEnvelope[]

  @@index([userId])
}

// A 1:1 conversation. The pair is stored normalised (aId < bId) so two people
// can only ever have one thread between them.
model ChatThread {
  id            String   @id @default(cuid())
  aId           String
  a             User     @relation("chatThreadA", fields: [aId], references: [id], onDelete: Cascade)
  bId           String
  b             User     @relation("chatThreadB", fields: [bId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages ChatMessage[]
  reads    ChatRead[]

  @@unique([aId, bId])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String     @id @default(cuid())
  threadId       String
  thread         ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User       @relation("chatSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderDeviceId String
  senderDevice   ChatDevice @relation("chatSenderDevice", fields: [senderDeviceId], references: [id], onDelete: Cascade)

  kind ChatKind @default(TEXT)

  // AES-256-GCM ciphertext of the typed message, base64. Empty for a bare
  // attachment. The server holds no key for this.
  body String @db.Text
  iv   String @db.VarChar(64)

  // Media: the bytes live on disk as ciphertext under storedName; the original
  // file name and mime type are themselves encrypted into mediaMeta.
  storedName String? @unique @db.VarChar(191)
  mediaMeta  String? @db.Text
  mediaIv    String? @db.VarChar(64)
  mediaSize  Int? // size of the ciphertext on disk, for the quota display
  durationMs Int? // voice-note length — needed to size the bubble before decrypting

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  envelopes ChatEnvelope[]

  @@index([threadId, createdAt])
}

// The message's content key, wrapped for exactly one device. A device that
// wasn't enrolled when the message was sent has no envelope, so the message
// stays unreadable there — that is the cost of the server holding no keys.
model ChatEnvelope {
  id         String      @id @default(cuid())
  messageId  String
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  deviceId   String
  device     ChatDevice  @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  wrappedKey String      @db.Text // content key, AES-GCM-wrapped to this device
  iv         String      @db.VarChar(64)
  ephemeral  String      @db.Text // sender's ephemeral ECDH public key, JWK

  @@unique([messageId, deviceId])
  @@index([deviceId])
}

// How far each person has read in a thread — drives the unread badge.
model ChatRead {
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt   DateTime

  @@id([threadId, userId])
}
