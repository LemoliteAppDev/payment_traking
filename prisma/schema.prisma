// PayTrack schema — MySQL. Money is integer paise (BigInt).
// See paytrack-handoff-spec.md §3 for the field-level rationale.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Status {
  AWAITING_APPROVAL
  RETURNED
  REQUESTED
  SCHEDULED
  PAID
  CONFIRMED
  HOLD
  CANCELLED
}

enum AttachmentKind {
  INSTRUCTION
  PROOF
}

enum EventType {
  REQUEST
  APPROVE
  RETURN
  RESUBMIT
  EDIT
  SCHEDULE
  PAY
  CONFIRM
  HOLD
  CANCEL
  NUDGE
  REMINDER
  NOTE
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  role           Role
  isPayer        Boolean   @default(false)
  isApprover     Boolean   @default(false)
  isManager      Boolean   @default(false)
  active         Boolean   @default(true)
  telegramChatId String?
  passwordHash   String?
  emailVerified  DateTime?
  notificationsReadAt DateTime?
  createdAt      DateTime  @default(now())

  requested   Payment[]      @relation("requestedBy")
  paid        Payment[]      @relation("paidBy")
  confirmed   Payment[]      @relation("confirmedBy")
  approved    Payment[]      @relation("approvedBy")
  events      PaymentEvent[]
  attachments Attachment[]

  accounts          Account[]
  sessions          Session[]
  pushSubscriptions PushSubscription[]
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @db.VarChar(512)
  p256dh    String   @db.VarChar(255)
  auth      String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Auth.js (NextAuth) adapter models ────────────────────────────────
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Payment {
  id            String    @id @default(cuid())
  amount        BigInt // integer paise
  payee         String
  payFrom       String     // name of a PayAccount (the source to pay from)
  purpose       String     @db.Text
  upi           String?
  status        Status    @default(REQUESTED)
  dueDate       DateTime
  scheduledFor  DateTime?
  editedAt      DateTime?
  approvedAt    DateTime?
  paidAt        DateTime?
  confirmedAt   DateTime?
  lastRemindedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requestedById String
  requestedBy   User    @relation("requestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("approvedBy", fields: [approvedById], references: [id])
  paidById      String?
  paidBy        User?   @relation("paidBy", fields: [paidById], references: [id])
  confirmedById String?
  confirmedBy   User?   @relation("confirmedBy", fields: [confirmedById], references: [id])

  attachments Attachment[]
  events      PaymentEvent[]

  @@index([status])
  @@index([requestedById])
  @@index([dueDate])
}

model Attachment {
  id           String         @id @default(cuid())
  paymentId    String
  payment      Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  kind         AttachmentKind
  originalName String
  storedName   String         @unique
  mimeType     String
  size         Int
  uploadedById String?
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())

  events PaymentEvent[]

  @@index([paymentId])
}

model PaymentEvent {
  id           String      @id @default(cuid())
  paymentId    String
  payment      Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?       @relation(fields: [actorId], references: [id])
  type         EventType
  message      String      @db.Text
  attachmentId String?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])
  meta         Json?
  createdAt    DateTime    @default(now())

  @@index([paymentId, createdAt])
}

// Sources money is paid from (the "Pay from" list). Managed by admins.
model PayAccount {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model IdempotencyKey {
  key       String   @id
  scope     String
  createdAt DateTime @default(now())
}
