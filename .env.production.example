# PayTrack — PRODUCTION env template (Hostinger). Copy to `.env` on the SERVER
# and fill the real values. NEVER commit the filled file. Secrets stay on the box.

# ─── Database (Hostinger MySQL) ─────────────────────────────────────
# Create a MySQL DB + user in hPanel, then:
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"

# ─── File uploads (persistent, writable, OUTSIDE the web root) ───────
UPLOAD_DIR="/home/<user>/paytrack-uploads"
MAX_UPLOAD_MB="10"

# ─── Auth (login ID + password) ─────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"
# Required in production so Auth.js trusts the host:
AUTH_URL="https://your-domain.com"
AUTH_TRUST_HOST="true"
# The 4 whitelisted login IDs (must match the seeded users). Set each user's
# password with `npm run set-password -- <id> "<pw>"` after seeding.
AUTH_WHITELIST="mahesh@payment.com,jignesh@payment.com,jagat@payment.com,bhadresh@payment.com"

# ─── Telegram — notifications ───────────────────────────────────────
TELEGRAM_BOT_TOKEN="CHANGE_ME"

# ─── Reminders / cron ───────────────────────────────────────────────
# Generate: openssl rand -hex 24
CRON_SECRET="CHANGE_ME"
WORK_HOURS_START="9"
WORK_HOURS_END="21"
APP_TZ="Asia/Kolkata"

NODE_ENV="production"
